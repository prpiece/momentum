{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Momentum",
  "version": "0.3.1",
  "identifier": "com.momentum.planner",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Momentum",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "dragDropEnabled": false
      },
      {
        "label": "quickadd",
        "title": "Momentum Quick Add",
        "url": "index.html?window=quickadd",
        "width": 620,
        "height": 170,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true,
        "dragDropEnabled": false
      },
      {
        "label": "reminder",
        "title": "Momentum Reminders",
        "url": "index.html?window=reminder",
        "width": 380,
        "height": 440,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Momentum",
    "shortDescription": "Offline planner: tasks, calendar, habits and Eisenhower Matrix"
  }
}
