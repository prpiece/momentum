{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: database, OS integration",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-execute",
    "notification:default",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "global-shortcut:allow-is-registered",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-unminimize",
    "core:window:allow-center",
    "core:window:allow-set-position",
    "core:window:allow-destroy",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-start-dragging",
    "core:window:allow-is-maximized",
    "core:window:allow-set-icon",
    "core:window:allow-request-user-attention",
    "core:webview:allow-set-webview-zoom",
    "updater:default",
    "process:allow-restart",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "http://*"
        }
      ]
    },
    "allow-set-close-to-tray",
    "allow-quit-app",
    "allow-agent-reply",
    "allow-agent-ready",
    "allow-agent-cli-info",
    "allow-agent-cli-path",
    "allow-secret-get",
    "allow-secret-set",
    "allow-secret-delete",
    "allow-toggle-mini",
    "allow-open-pop-window",
    "allow-write-text-file",
    "allow-write-png",
    "allow-read-text-file",
    "allow-backups-dir",
    "allow-image-dir",
    "allow-pick-path",
    "allow-import-image",
    "allow-write-image",
    "allow-list-images",
    "allow-delete-image",
    "allow-write-backup-zip",
    "allow-write-auto-backup",
    "allow-set-backup-folder",
    "allow-read-backup-zip",
    "allow-restore-backup-attachments",
    "allow-fetch-ics",
    "allow-voice-model-status",
    "allow-voice-download",
    "allow-voice-cancel-download",
    "allow-voice-remove",
    "allow-voice-start",
    "allow-voice-input-devices",
    "allow-voice-stop",
    "allow-voice-cancel"
  ]
}